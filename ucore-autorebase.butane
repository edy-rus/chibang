variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAyrjlr3Z4JJzTwlbDgYeLadmEcPhATWpRLmL/yyu4h2
      # Filled in by build-ign.sh from `pass homelab/chibang/core-hash` (console login + sudo)
      password_hash: ${CORE_PASSWORD_HASH}
storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: chibang
    # Needed for the Tailscale exit node
    - path: /etc/sysctl.d/99-tailscale.conf
      mode: 0644
      contents:
        inline: |
          net.ipv4.ip_forward = 1
          net.ipv6.conf.all.forwarding = 1
    - path: /etc/firewalld/zones/FedoraServer.xml
      mode: 0644
      overwrite: true
      contents:
        inline: |
          <?xml version="1.0" encoding="utf-8"?>
          <zone>
            <short>Public</short>
            <description>For use in public areas. Only selected incoming connections are accepted.</description>
            <service name="ssh"/>
            <service name="dhcpv6-client"/>
            <service name="cockpit"/>
            <masquerade/>
            <forward/>
          </zone>
    - path: /etc/firewalld/zones/trusted.xml
      mode: 0644
      overwrite: true
      contents:
        inline: |
          <?xml version="1.0" encoding="utf-8"?>
          <zone target="ACCEPT">
            <short>Trusted</short>
            <description>All network connections are accepted.</description>
            <interface name="tailscale0"/>
            <forward/>
          </zone>
    # Used by restic-offsite.service. Credentials are in core's rclone.conf (not here).
    - path: /usr/local/bin/restic-offsite.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          R=/var/hdd_pool/transfer/restic; D=mega:backup/
          [ -f "$R/config" ] && [ -d "$R/data" ]            || { echo "ABORT: local repo missing"; exit 1; }
          [ -z "$(ls -A "$R/locks" 2>/dev/null)" ]          || { echo "ABORT: repo locked (backup/prune running)"; exit 1; }
          rclone cat "${D}config" | cmp -s - "$R/config"    || { echo "ABORT: remote is not the same repo"; exit 1; }
          rclone sync "$R" "$D" --stats 5m --stats-one-line -v
systemd:
  units:
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-hci:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
        
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-hci:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
        
    # First boot only: import existing pools and seed /etc/zfs/zpool.cache.
    # After that the stock zfs-import-cache.service imports them, so this
    # unit skips itself.
    - name: zfs-firstboot-import.service
      enabled: true
      contents: |
        [Unit]
        Description=First-boot import of existing ZFS pools (seeds zpool.cache)
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=!/etc/zfs/zpool.cache
        After=systemd-udev-settle.service zfs-import-cache.service
        Before=zfs-mount.service zfs-import.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/sbin/zpool import -a -N -d /dev/disk/by-id -o cachefile=/etc/zfs/zpool.cache

        [Install]
        WantedBy=zfs-import.target multi-user.target

    # uCore's stock zfs-load-key.service is an empty stub, so supply a real one.
    # hdd_pool/enc uses keylocation=file:///etc/zfs/hdd_pool_enc.key. That file
    # is NOT in this config: restore it from pass before first boot or enc
    # won't unlock.
    - name: zfs-load-key.service
      enabled: true
      contents: |
        [Unit]
        Description=Load ZFS encryption keys
        DefaultDependencies=no
        After=zfs-import.target
        Before=zfs-mount.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/sbin/zfs load-key -a

        [Install]
        WantedBy=zfs-mount.service

    # Nightly mirror of the restic repo to offsite (MEGA S4 via rclone).
    # Runs /usr/local/bin/restic-offsite.sh (see storage.files). Needs
    # core's rclone.conf in /var/home/core/.config/rclone/; restore that from
    # pass, it holds the credentials.
    - name: restic-offsite.service
      contents: |
        [Unit]
        Description=Mirror restic repo to MEGA S4
        Wants=network-online.target
        After=network-online.target
        RequiresMountsFor=/var/hdd_pool/transfer

        [Service]
        Type=oneshot
        User=core
        ExecStart=/usr/local/bin/restic-offsite.sh
        Nice=10
        IOSchedulingClass=idle

    - name: restic-offsite.timer
      enabled: true
      contents: |
        [Unit]
        Description=Nightly restic offsite mirror

        [Timer]
        OnCalendar=*-*-* 00:00:00
        Persistent=true

        [Install]
        WantedBy=timers.target

    # Log in only if tailscaled isn't already logged in. The auth key lives on the
    # pool; without it this unit skips and you run `tailscale up` by hand.
    - name: tailscale-init.service
      enabled: true
      contents: |
        [Unit]
        Description=First-boot Tailscale login (no-op once the node is logged in)
        After=network-online.target zfs-mount.service tailscaled.service
        Wants=network-online.target tailscaled.service
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=/var/hdd_pool/secrets/tailscale.auth

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStartPre=/usr/bin/systemctl enable tailscaled.service
        ExecStart=/bin/sh -c '/usr/bin/tailscale status >/dev/null 2>&1 || /usr/bin/tailscale up --auth-key=file:/var/hdd_pool/secrets/tailscale.auth --advertise-exit-node'
        
        [Install]
        WantedBy=multi-user.target
