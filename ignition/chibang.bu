# Minimal Ignition for a fresh Fedora CoreOS install: SSH key, hostname, and a
# two-step rebase to our signed image. Everything else lives in the image.
# No secrets in here, so it is safe to publish. Fedora CoreOS 45+ Ignition reads
# Butane YAML directly; CI (validate-ignition.yml) checks it with butane --strict.
variant: fcos
version: 1.6.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAyrjlr3Z4JJzTwlbDgYeLadmEcPhATWpRLmL/yyu4h2
storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: chibang
systemd:
  units:
    # Step 1: stock FCOS doesn't trust our key yet, so pull unverified once.
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase to chibang image (unverified) and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/edy-rus/chibang:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    # Step 2: our image ships the policy + pubkey, so switch to the signed ref.
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=Rebase to chibang image (signed) and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/edy-rus/chibang:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
